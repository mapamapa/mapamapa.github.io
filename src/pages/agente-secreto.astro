---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'MUBI — El Agente Secreto';
const description = 'Lanzamiento en MUBI de El Agente Secreto, de Kleber Mendonça Filho: un listening bar en RI.CO.HIFI ambientado en el Recife de 1977, con dominó, tragos y música de la época.';

// La foto de los flyers es la portada en la home; no se repite dentro de la página.
const gallery = {
  hero: '/img/agente-secreto/hero.jpg',
  afiche: '/img/agente-secreto/afiche.jpg',
  lampara: '/img/agente-secreto/lampara.jpg',
  domino: '/img/agente-secreto/domino.jpg',
  bar: '/img/agente-secreto/bar.jpg',
  mesa: '/img/agente-secreto/mesa.jpg',
  sala: '/img/agente-secreto/sala.jpg',
  sala2: '/img/agente-secreto/sala-2.jpg',
};
---

<BaseLayout title={title} description={description} image={gallery.hero}>
  <section class="production container">
    <header class="production__header">
      <figure class="production__hero reveal">
        <img
          src={gallery.hero}
          alt="Sala de RI.CO.HIFI ambientada como listening bar para El Agente Secreto"
          width="1164"
          height="480"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="production__heading reveal reveal-delay-1">
        <h1>MUBI — El Agente Secreto</h1>
        <p class="production__subtitle">Película de Kleber Mendonça Filho — Lanzamiento vía streaming en MUBI</p>
      </div>
    </header>

    <!-- Texto y foto se alternan en zigzag; el primer párrafo va repartido en dos filas -->
    <section class="production__editorial" aria-labelledby="agente-copy-title">
      <h2 id="agente-copy-title" class="sr-only">Descripción del proyecto</h2>

      <div class="production__row reveal reveal-delay-2">
        <div class="production__text">
          <p>
            Recife, semana de carnaval, 1977. Bajo la dictadura, un hombre vuelve a su ciudad a buscar a su hijo mientras algo lo persigue.
          </p>
        </div>
        <figure class="production__card production__card--tall">
          <img
            src={gallery.afiche}
            alt="Invitadas observando el afiche de El Agente Secreto en la entrada"
            width="720"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="production__row production__row--flip reveal reveal-delay-2">
        <figure class="production__card production__card--tall">
          <img
            src={gallery.lampara}
            alt="Lámpara de mesa sobre los flyers de la película"
            width="720"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="production__text">
          <p>
            El Agente Secreto, la más reciente película de Kleber Mendonça Filho, no cuenta esa tensión desde el thriller clásico: la esconde en lo cotidiano, en un carnaval que sigue sonando aunque el peligro esté a la vuelta de la esquina, en el humor que se cuela incluso en los momentos más oscuros. Ese es el pulso que quisimos trasladar al lanzamiento del filme en MUBI.
          </p>
        </div>
      </div>

      <div class="production__row reveal reveal-delay-2">
        <div class="production__text">
          <p>
            En RI.CO.HIFI (Ritmo Colectivo) armamos un listening bar ambientado en ese Brasil de fines de los 70: conversaciones a media voz, tragos, una selección musical que devuelve al oyente a esa época y mesas de dominó donde los invitados se sentaron a jugar como quien mata el tiempo en una esquina de Recife. No fue una proyección ni una muestra de afiches: fue una escenografía pensada para que, por una noche, se pudiera habitar, aunque fuera un fragmento, el mismo aire que respira la película.
          </p>
        </div>
        <figure class="production__card production__card--tall">
          <img
            src={gallery.domino}
            alt="Manos jugando dominó sobre una mesa del bar"
            width="720"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="production__row production__row--flip reveal reveal-delay-2">
        <figure class="production__card production__card--tall">
          <img
            src={gallery.bar}
            alt="Barra de RI.CO.HIFI con luz cálida durante el lanzamiento"
            width="720"
            height="1080"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="production__text">
          <p>
            Para MAPAMAPA, lanzar una película en streaming es también una pregunta de diseño: cómo darle cuerpo físico a algo que va a vivir en una pantalla. Con El Agente Secreto la respuesta fue no ilustrar la trama, sino construir el clima que la sostiene.
          </p>
        </div>
      </div>
    </section>

    <!-- Cierre: la sala -->
    <section class="production__gallery" aria-label="Más imágenes del evento">
      <figure class="production__card production__card--g1 reveal reveal-delay-1">
        <img
          src={gallery.mesa}
          alt="Mesa con flyers, cubiertos y lámpara"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="production__card production__card--g2 reveal reveal-delay-2">
        <img
          src={gallery.sala}
          alt="Sillas con bolsas de MUBI frente a las cortinas del bar"
          width="1620"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="production__card production__card--g3 reveal reveal-delay-3">
        <img
          src={gallery.sala2}
          alt="Vista general de la sala ambientada"
          width="1620"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  </section>
</BaseLayout>

<style>
  .production {
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: var(--space-xl);
  }

  .production__header {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .production__hero {
    overflow: hidden;
    background: #060606;
    height: 540px;
  }

  .production__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .production__heading {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .production__heading h1 {
    font-size: clamp(2rem, 1.5rem + 2.8vw, 4rem);
    text-transform: uppercase;
    line-height: 0.95;
    color: #d7d7d7;
  }

  .production__subtitle {
    font-size: clamp(1rem, 0.8rem + 1.2vw, 1.5rem);
    color: #999;
    line-height: 1.1;
  }

  .production__editorial {
    display: grid;
    gap: var(--space-lg);
  }

  /* Cada fila: texto a un lado, foto al otro. Las filas --flip invierten el orden. */
  .production__row {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: var(--space-md);
    align-items: center;
  }

  .production__row--flip {
    grid-template-columns: 7fr 5fr;
  }

  .production__text {
    display: grid;
    gap: 1rem;
  }

  .production__text p {
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.18rem);
    line-height: 1.08;
    color: #c8c8c8;
    max-width: 48ch;
  }

  .production__row--flip .production__text {
    justify-self: end;
  }

  .production__card {
    overflow: hidden;
    background: #060606;
  }

  .production__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .production__card--tall {
    height: 620px;
  }

  /* Cierre: un retrato, una horizontal y una a todo el ancho */
  .production__gallery {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-xs);
    margin-top: var(--space-xl);
  }

  .production__card--g1 {
    grid-column: 1 / 5;
    height: 460px;
  }

  .production__card--g2 {
    grid-column: 5 / -1;
    height: 460px;
  }

  .production__card--g3 {
    grid-column: 1 / -1;
    height: 520px;
  }

  @media (min-width: 900px) {
    .production__header {
      margin-bottom: var(--space-md);
    }
  }

  @media (max-width: 899px) {
    .production__editorial {
      gap: var(--space-md);
    }

    .production__row,
    .production__row--flip {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    /* En una columna, el texto siempre va antes de su foto */
    .production__row--flip .production__text {
      order: -1;
      justify-self: start;
    }

    .production__card--tall {
      height: 360px;
    }

    .production__gallery {
      grid-template-columns: 1fr;
      margin-top: var(--space-lg);
    }

    .production__card--g1,
    .production__card--g2,
    .production__card--g3 {
      grid-column: auto;
      height: 280px;
    }
  }
</style>
