---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'MUBI — La Misteriosa Mirada del Flamenco';
const description = 'Lanzamiento en MUBI de La misteriosa mirada del flamenco, película de Diego Céspedes: ambientación que recrea el club Miss Alaska como refugio de familia elegida.';

// La foto del neón es la portada en la home; no se repite dentro de la página.
const gallery = {
  hero: '/img/mubi/hero.jpg',
  performer: '/img/mubi/performer.jpg',
  retrato: '/img/mubi/retrato.jpg',
  bingo: '/img/mubi/bingo.jpg',
  mesa: '/img/mubi/mesa.jpg',
  mesaPerformer: '/img/mubi/mesa-performer.jpg',
  manos: '/img/mubi/manos.jpg',
};
---

<BaseLayout title={title} description={description} image={gallery.hero}>
  <section class="production container">
    <header class="production__header">
      <figure class="production__hero reveal">
        <img
          src={gallery.hero}
          alt="Escenario del club Miss Alaska recreado para el lanzamiento en MUBI"
          width="1164"
          height="480"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="production__heading reveal reveal-delay-1">
        <h1>MUBI — La Misteriosa Mirada del Flamenco</h1>
        <p class="production__subtitle">Película de Diego Céspedes — Estreno vía streaming en MUBI</p>
      </div>
    </header>

    <section class="production__editorial" aria-labelledby="mubi-copy-title">
      <div class="production__copy reveal reveal-delay-2">
        <h2 id="mubi-copy-title" class="sr-only">Descripción del proyecto</h2>
        <p>
          En el desierto de Atacama, en un campamento minero donde el sol raja la tierra y las noticias tardan en llegar, un grupo de personas decide que la familia se elige, no se hereda. Ese es el punto de partida de La misteriosa mirada del flamenco, la primera película de Diego Céspedes: una comunidad que se sostiene entre el miedo a una enfermedad que nadie nombra y el rechazo de quienes prefieren no mirar, y que aun así, o justamente por eso, encuentra espacio para el amor.
        </p>
        <p>
          MAPAMAPA tomó esa idea de familia elegida, artificio y cariño como refugio, y la convirtió en el lenguaje del lanzamiento en MUBI, recreando particularmente la escena de Miss Alaska: un club vintage, íntimo, de barrio, el mismo gesto de comunidad que sostiene a la película, hecho espacio.
        </p>
        <p>
          La ambientación no buscó ilustrar la película, sino interpretarla: recreó ese mismo pulso entre lo doméstico y lo excesivo, entre la ronda cotidiana de una comunidad y el glamour que ahí funciona como refugio. Por una noche, el estreno no se contó, se habitó, con el mismo gesto de familia elegida que sostiene la narrativa.
        </p>
      </div>

      <figure class="production__card production__card--q1 reveal reveal-delay-2">
        <img
          src={gallery.performer}
          alt="Performer en vestido rojo bajo la luz del club"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--q2 reveal reveal-delay-2">
        <img
          src={gallery.retrato}
          alt="Retrato de performer con peluca rubia y joyas"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--q3 reveal reveal-delay-3">
        <img
          src={gallery.bingo}
          alt="Cartones de bingo y mantel floreado sobre la mesa"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--q4 reveal reveal-delay-3">
        <img
          src={gallery.mesa}
          alt="Mesa con flores, velas y botellas de vino"
          width="1620"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--q5 reveal reveal-delay-3">
        <img
          src={gallery.mesaPerformer}
          alt="Performer sentada en una mesa del club"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--q6 reveal reveal-delay-4">
        <img
          src={gallery.manos}
          alt="Detalle de manos con uñas decoradas"
          width="720"
          height="1080"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  </section>
</BaseLayout>

<style>
  .production {
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: var(--space-xl);
  }

  .production__header {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .production__hero {
    overflow: hidden;
    background: #060606;
    height: 540px;
  }

  .production__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .production__heading {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .production__heading h1 {
    font-size: clamp(2rem, 1.5rem + 2.8vw, 4rem);
    text-transform: uppercase;
    line-height: 0.95;
    color: #d7d7d7;
  }

  .production__subtitle {
    font-size: clamp(1rem, 0.8rem + 1.2vw, 1.5rem);
    color: #999;
    line-height: 1.1;
  }

  /* Mosaico de 12 columnas (misma lógica que Artel) */
  .production__editorial {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0;
    align-items: start;
  }

  .production__copy {
    grid-column: span 5;
    display: grid;
    gap: 1rem;
    padding-right: var(--space-md);
  }

  .production__copy p {
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.18rem);
    line-height: 1.08;
    color: #c8c8c8;
    max-width: 58ch;
  }

  .production__card {
    overflow: hidden;
    background: #060606;
  }

  .production__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Fila 1: texto + dos retratos */
  .production__card--q1 {
    grid-column: 6 / 9;
    height: 560px;
  }

  .production__card--q2 {
    grid-column: 9 / -1;
    height: 560px;
  }

  /* Fila 2: tres piezas de distinto ancho */
  .production__card--q3 {
    grid-column: 1 / 4;
    height: 420px;
  }

  .production__card--q4 {
    grid-column: 4 / 8;
    height: 420px;
  }

  .production__card--q5 {
    grid-column: 8 / -1;
    height: 420px;
  }

  /* Fila 3: detalle suelto a la izquierda */
  .production__card--q6 {
    grid-column: 1 / 4;
    height: 360px;
  }

  @media (min-width: 900px) {
    .production__header {
      margin-bottom: var(--space-md);
    }

    .production__copy {
      padding-top: 0.25rem;
    }
  }

  @media (max-width: 899px) {
    .production__editorial {
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    .production__copy {
      grid-column: 1 / -1;
      padding-right: 0;
      margin-bottom: var(--space-sm);
    }

    .production__card--q1,
    .production__card--q2,
    .production__card--q3,
    .production__card--q4,
    .production__card--q5,
    .production__card--q6 {
      grid-column: auto;
      height: 300px;
    }
  }
</style>
