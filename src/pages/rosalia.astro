---
import BaseLayout from '@/layouts/BaseLayout.astro';

const title = 'LUX — Rosalía';
const description = 'Escenografía para la sesión de escucha mundial del álbum LUX de Rosalía, experiencia de Sony Music: un espacio completamente blanco envuelto en luces, proyecciones y aromas.';

const gallery = {
  hero: '/img/rosalia/hero.jpg',
  pasillo: '/img/rosalia/pasillo.jpg',
  butacas: '/img/rosalia/butacas.jpg',
  telas: '/img/rosalia/telas.jpg',
  sillas: '/img/rosalia/sillas.jpg',
};
---

<BaseLayout title={title} description={description} image={gallery.hero}>
  <section class="production container">
    <header class="production__header">
      <figure class="production__hero reveal">
        <img
          src={gallery.hero}
          alt="Sala completamente blanca con telas y butacas para la sesión de escucha de LUX"
          width="1164"
          height="480"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="production__heading reveal reveal-delay-1">
        <h1>LUX — Rosalía</h1>
        <p class="production__subtitle">Sesión de escucha — Sony Music</p>
      </div>
    </header>

    <section class="production__editorial" aria-labelledby="rosalia-copy-title">
      <div class="production__copy reveal reveal-delay-2">
        <h2 id="rosalia-copy-title" class="sr-only">Descripción del proyecto</h2>
        <p>
          Cuando la identidad de una experiencia está bien definida desde el inicio, es capaz de mantenerse consistente sin importar el lugar donde ocurra.
        </p>
        <p>
          Para la gira mundial de la sesión de escucha de su álbum LUX, MAPAMAPA construyó una experiencia pensada para que los fans no solo escucharan el disco, sino que se dejaran llevar por él: un espacio completamente blanco —telas, asientos, paredes, piso—, envuelto en luces, proyecciones y aromas que, todos juntos, eran parte de una misma experiencia para interpretar la música.
        </p>
        <p>
          En MAPAMAPA estuvimos a cargo de la escenografía de esta experiencia de Sony Music, a la que fuimos invitados por eMe Estudio Creativo. Convocamos a un equipo de colaboradores que se encargó del diseño y montaje textil que vistió por completo la sala.
        </p>
      </div>

      <figure class="production__card production__card--side reveal reveal-delay-2">
        <img
          src={gallery.pasillo}
          alt="Pasillo de telas blancas hacia la entrada de la sala"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--right reveal reveal-delay-3">
        <img
          src={gallery.butacas}
          alt="Butacas blancas frente a las cortinas de la sala"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--d1 reveal reveal-delay-4">
        <img
          src={gallery.telas}
          alt="Detalle de las telas blancas que cubren el piso"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="production__card production__card--d2 reveal reveal-delay-4">
        <img
          src={gallery.sillas}
          alt="Sillas blancas alineadas dentro de la sala"
          width="1080"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>
  </section>
</BaseLayout>

<style>
  .production {
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: var(--space-xl);
  }

  .production__header {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .production__hero {
    overflow: hidden;
    background: #060606;
    height: 540px;
  }

  .production__hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .production__heading {
    display: grid;
    gap: 0.4rem;
    width: 100%;
  }

  .production__heading h1 {
    font-size: clamp(2rem, 1.5rem + 2.8vw, 4rem);
    text-transform: uppercase;
    line-height: 0.95;
    color: #d7d7d7;
  }

  .production__subtitle {
    font-size: clamp(1rem, 0.8rem + 1.2vw, 1.5rem);
    color: #999;
    line-height: 1.1;
  }

  .production__editorial {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 0;
    align-items: start;
  }

  .production__copy {
    grid-column: span 6;
    display: grid;
    gap: 1rem;
    padding-right: var(--space-md);
  }

  .production__copy p {
    font-size: clamp(1rem, 0.92rem + 0.35vw, 1.18rem);
    line-height: 1.08;
    color: #c8c8c8;
    max-width: 58ch;
  }

  .production__card {
    overflow: hidden;
    background: #060606;
  }

  .production__card img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .production__card--side {
    grid-column: 9 / -1;
    grid-row: 1 / 3;
  }

  .production__card--right {
    grid-column: 9 / -1;
    grid-row: 3;
  }

  .production__card--d1 {
    grid-column: 1 / 4;
    grid-row: 3;
  }

  .production__card--d2 {
    grid-column: 4 / 7;
    grid-row: 3;
  }

  @media (min-width: 900px) {
    .production__header {
      margin-bottom: var(--space-md);
    }

    .production__copy {
      padding-top: 0.25rem;
    }
  }

  @media (max-width: 899px) {
    .production__editorial {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.5rem;
    }

    .production__copy {
      grid-column: 1 / -1;
      grid-row: auto;
      padding-right: 0;
      margin-bottom: var(--space-sm);
    }

    .production__card--side,
    .production__card--right,
    .production__card--d1,
    .production__card--d2 {
      grid-column: auto;
      grid-row: auto;
    }
  }
</style>
